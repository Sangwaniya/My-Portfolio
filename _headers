# Cloudflare Pages / Netlify header rules. Plain text, no build step needed.

# The 241 hero frames and the fonts never change once deployed — let browsers
# and the CDN hold them for a year so a repeat visit costs nothing.
/public/hero/frames/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS do change. A day is long enough to help, short enough that an
# edit shows up without a hard refresh.
/assets/css/*
  Cache-Control: public, max-age=86400

/assets/js/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
